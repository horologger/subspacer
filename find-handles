#!/usr/bin/env bash
set -euo pipefail

# Print all handles in data/scanned-pubkeys.csv whose script_pubkey matches the argument.

if [[ $# -ne 1 ]] || [[ -z "${1:-}" ]]; then
  echo "Usage: $0 <script_pubkey>" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CSV="$ROOT/data/scanned-pubkeys.csv"

if [[ ! -f "$CSV" ]]; then
  echo "find-handles: missing $CSV (run scan-script-pubkeys first)" >&2
  exit 1
fi

script_pubkey="$1"

awk -v spk="$script_pubkey" '
  {
    i = index($0, ",")
    if (i == 0) next
    handle = substr($0, 1, i - 1)
    pubkey = substr($0, i + 1)
    if (pubkey == spk) print handle
  }
' "$CSV"
